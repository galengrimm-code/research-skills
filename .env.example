# Research Skills — API key template
#
# Copy this file to `skills/deep-research/.env` and fill in your keys.
# The other two skills (research, content-research) source from this same file.
#
# Most keys have generous free tiers. Skills gracefully degrade when a key
# is missing — they just skip that source and note "gaps" in the report.

# Web search (pick one or both — Serper is cheaper, SerpAPI has more endpoints)
SERPAPI_KEY=                          # https://serpapi.com (100 free searches/month)
SERPER_API_KEY=                       # https://serper.dev (2,500 free queries on signup)

# Webpage scraping
FIRECRAWL_API_KEY=                    # https://firecrawl.dev (500 free lifetime credits — use sparingly)

# Academic literature (used by /research and /deep-research when topic is research-heavy)
OPENALEX_KEY=                         # https://openalex.org (free; not actually required, but lifts rate limit)
UNPAYWALL_EMAIL=                      # https://unpaywall.org (free; just an email for politeness header)

# Podcast search + transcripts (used by /content-research and /research)
LISTEN_API_KEY=                       # https://listennotes.com/api (FREE tier: 30 results/query)

# Code search, CVE-to-package mapping, repo discovery (all 3 skills)
# Generate a fine-grained PAT with no extra scopes (public read only)
GITHUB_TOKEN=                         # https://github.com/settings/tokens (5,000 req/hour authenticated)

# Semantic search ("find me more like this concept") — /research, /deep-research
EXA_API_KEY=                          # https://exa.ai ($10 trial credits, then paid)

# Reddit community sentiment (used by /research Pulse mode — public *.json is now blocked,
# so the authenticated API is the only working path). Create a "script" app at
# https://www.reddit.com/prefs/apps — it gives you both values below.
REDDIT_CLIENT_ID=                     # the string shown under the app name
REDDIT_CLIENT_SECRET=                 # the "secret" field

# Notes:
# - Wayback Machine CDX needs no auth; it just works.
# - Hacker News (hn.algolia.com) needs no auth; it just works.
# - WebFetch, yt-dlp, faster-whisper, and Playwright are local tools — no keys needed.
# - All keys are optional. Skills gracefully degrade and note "gaps" when a key is missing.
